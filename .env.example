# Everything is optional: with no .env the platform runs in offline mock mode.

# ---------------------------------------------------------------- LLM
# mock | openai | azure_openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional USD per 1M tokens for models not in llm/pricing.py
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# ---------------------------------------------------------------- Retrieval
# hashing (offline) | openai | azure_openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
# Calibrated for hashing embeddings; use ~0.3 with OpenAI embeddings
MIN_SIMILARITY=0.18
RETRIEVAL_TOP_K=4
# e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 (pip install ".[rerank]")
RERANKER_MODEL=

# ---------------------------------------------------------------- Storage
# Empty = in-memory. Postgres + pgvector enables persistent RAG, audit log and checkpoints.
DATABASE_URL=
# Empty = in-process MCP server; e.g. http://localhost:8001/mcp for a remote one
MCP_SERVER_URL=

# ---------------------------------------------------------------- Security
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- Observability
# OTLP/HTTP collector, e.g. http://localhost:4318 (Jaeger, Langfuse, Azure Monitor collector)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
